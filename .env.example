# =============================================================================
# GeoSearch POC API - Environment Variables Configuration
# =============================================================================
# 
# This file contains all environment variables used by the GeoSearch POC API.
# Copy this file to .env and update the values according to your environment.
#
# IMPORTANT: Never commit the actual .env file to version control!
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application name and version
APP_NAME=geosearch-poc
APP_VERSION=1.0.0

# Server port (default: 8080)
PORT=8080

# Gin framework mode (debug, release, test)
# Use 'debug' for development, 'release' for production
GIN_MODE=debug

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection URL (PostgreSQL with PostGIS)
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/geosearch?sslmode=disable

# Alternative: Individual database configuration (if not using DATABASE_URL)
# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database user
DB_USER=postgres

# Database password
DB_PASSWORD=postgres

# Database name
DB_NAME=geosearch

# Database connection pool size
DB_POOL_SIZE=10

# =============================================================================
# GOOGLE CLOUD CONFIGURATION (Vertex AI Retail Search)
# =============================================================================

# Google Cloud Project ID
# Required for Vertex AI Retail Search integration
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Google Cloud location/region
# Common values: us-central1, us-east1, europe-west1, asia-northeast1
GOOGLE_CLOUD_LOCATION=us-central1

# Retail Search catalog name
# This is the catalog where products will be indexed for search
GOOGLE_CLOUD_CATALOG=default_catalog

# Path to Google Cloud service account credentials file
# This file should be placed in the credentials/ directory
GOOGLE_CLOUD_CREDENTIALS_FILE=credentials/google-cloud-key.json

# =============================================================================
# H3 INDEXING CONFIGURATION
# =============================================================================

# H3 resolution for geographic indexing
# Resolution 9 = ~1km cells, Resolution 8 = ~4km cells, Resolution 10 = ~173m cells
H3_RESOLUTION=9

# =============================================================================
# SERVER PERFORMANCE CONFIGURATION
# =============================================================================

# Server read timeout in seconds
SERVER_READ_TIMEOUT=5

# Server write timeout in seconds
SERVER_WRITE_TIMEOUT=10

# Maximum header bytes (1MB = 1048576 bytes)
SERVER_MAX_HEADER_BYTES=1048576

# Server shutdown timeout in seconds
SERVER_SHUTDOWN_TIMEOUT=10

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test database configuration (used by integration tests)
# These values are used when running tests with .env.testing
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=geosearch_test
TEST_DB_POOL_SIZE=5

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Enable/disable SSL for database connections
# Use 'require' for production, 'disable' for development
DB_SSL_MODE=disable

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# Enable/disable structured logging
LOG_STRUCTURED=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable/disable CORS for development
CORS_ENABLED=true

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Enable/disable request logging middleware
REQUEST_LOGGING_ENABLED=true

# =============================================================================
# NOTES AND EXAMPLES
# =============================================================================

# Example Google Cloud Project setup:
# 1. Create a project in Google Cloud Console
# 2. Enable Vertex AI API
# 3. Create a service account with Retail Search permissions
# 4. Download the JSON key file to credentials/google-cloud-key.json
# 5. Update GOOGLE_CLOUD_PROJECT_ID with your project ID
#
# Example database setup:
# 1. Install PostgreSQL with PostGIS extension
# 2. Create database: CREATE DATABASE geosearch;
# 3. Enable PostGIS: CREATE EXTENSION postgis;
# 4. Run migrations: go run cmd/migrate/main.go
#
# Example for Docker development:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/geosearch?sslmode=disable
# DB_HOST=postgres
# GOOGLE_CLOUD_CREDENTIALS_FILE=/app/credentials/google-cloud-key.json