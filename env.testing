# =============================================================================
# GeoSearch POC API - Testing Environment Variables
# =============================================================================
# 
# This file contains environment variables for running integration tests.
# Used by the test suite to connect to a separate test database.
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION (Testing)
# =============================================================================

APP_NAME=geosearch-poc-test
APP_VERSION=1.0.0
PORT=8081
GIN_MODE=test

# =============================================================================
# TEST DATABASE CONFIGURATION
# =============================================================================

# Test database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/geosearch_test?sslmode=disable

# Individual test database configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=geosearch_test
DB_POOL_SIZE=5

# =============================================================================
# GOOGLE CLOUD CONFIGURATION (Testing)
# =============================================================================

# Use mock credentials for testing
GOOGLE_CLOUD_PROJECT_ID=test-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_CATALOG=test_catalog
GOOGLE_CLOUD_CREDENTIALS_FILE=credentials/test-google-cloud-key.json

# =============================================================================
# H3 INDEXING CONFIGURATION (Testing)
# =============================================================================

H3_RESOLUTION=9

# =============================================================================
# SERVER PERFORMANCE CONFIGURATION (Testing)
# =============================================================================

SERVER_READ_TIMEOUT=2
SERVER_WRITE_TIMEOUT=5
SERVER_MAX_HEADER_BYTES=1048576
SERVER_SHUTDOWN_TIMEOUT=5

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test timeout settings
TEST_TIMEOUT=30s
TEST_RETRY_ATTEMPTS=3

# Enable test logging
LOG_LEVEL=debug
LOG_STRUCTURED=false

# Disable CORS for tests
CORS_ENABLED=false
REQUEST_LOGGING_ENABLED=false 