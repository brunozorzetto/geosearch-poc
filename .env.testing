# GeoSearch POC API - Testing Environment Configuration
# Copy this file to .env.testing and update the values for testing

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
PORT=8080
GIN_MODE=test
APP_NAME=geosearch-poc
APP_VERSION=1.0.0

# =============================================================================
# DATABASE CONFIGURATION (Testing Database)
# =============================================================================
# Test database connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/geosearch_test?sslmode=disable

# Individual test database configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=geosearch_test
DB_POOL_SIZE=5

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_READ_TIMEOUT=5
SERVER_WRITE_TIMEOUT=10
SERVER_MAX_HEADER_BYTES=1048576
SERVER_SHUTDOWN_TIMEOUT=10

# =============================================================================
# GOOGLE CLOUD CONFIGURATION (Testing)
# =============================================================================
# For testing, you can use mock values or a test project
GOOGLE_CLOUD_PROJECT_ID=test-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_CATALOG=test-search-catalog
GOOGLE_CLOUD_CREDENTIALS_FILE=./credentials/test-service-account-key.json

# =============================================================================
# TESTING SPECIFIC CONFIGURATION
# =============================================================================
# Enable test mode
TEST_MODE=true

# Test data configuration
TEST_DATA_ENABLED=true
TEST_STORES_COUNT=10
TEST_PRODUCTS_COUNT=50

# Mock external services for testing
MOCK_GOOGLE_CLOUD=true
MOCK_SEARCH_RESPONSE=true