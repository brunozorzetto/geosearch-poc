	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Log da requisição para debug",
					"console.log('Request:', pm.request.method, pm.request.url);"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Testes básicos de resposta",
					"pm.test('Status code is valid', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 404, 500]);",
					"});",
					"",
					"pm.test('Response time is less than 5000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// Se a resposta for JSON, testar se é válida",
					"if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
					"    pm.test('Response is valid JSON', function () {",
					"        pm.response.to.have.jsonBody();",
					"    });",
					"}",
					"",
					"// Para respostas de sucesso, verificar se não há erro",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    pm.test('Response does not contain error', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.not.have.property('error');",
					"    });",
					"}",
					"",
					"// Para respostas de erro, verificar se há mensagem de erro",
					"if (pm.response.code === 400 || pm.response.code === 404 || pm.response.code === 500) {",
					"    pm.test('Response contains error message', function () {",
					"        const jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('error');",
					"    });",
					"}"
				]
			}
		}
	],
