{
	"info": {
		"_postman_id": "geosearch-poc-api-collection",
		"name": "GeoSearch POC API",
		"description": "Collection completa para testar todos os endpoints da API GeoSearch POC\n\nEsta API permite:\n- Gerenciar stores (lojas) com localização geográfica\n- Gerenciar produtos associados a stores\n- Buscar stores por proximidade geográfica\n- Buscar produtos usando Vertex AI Search\n\nBase URL: http://localhost:8080/api/v1",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "geosearch-poc"
	},
	"item": [
		{
			"name": "Stores",
			"description": "Endpoints para gerenciamento de stores (lojas)",
			"item": [
				{
					"name": "Create Store",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Loja Exemplo\",\n  \"latitude\": -23.550520,\n  \"longitude\": -46.633308,\n  \"address\": \"Av. Paulista, 1000\",\n  \"delivery_radius\": 5.0\n}"
						},
						"url": {
							"raw": "{{base_url}}/stores",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"stores"
							]
						},
